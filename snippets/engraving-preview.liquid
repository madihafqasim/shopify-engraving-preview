{%- doc -%}
  Engraving preview. Shows the customer's text on the product photo as they
  type, and saves it to the order as line item properties.

  @param {product} product - The product being engraved
  @param {object} section - The product section, used for unique IDs
  @param {string} [form_id] - ID of the theme's add to cart form. Optional: the
    script finds the product form itself if this ID doesn't exist on the page.
{%- enddoc -%}

{%- comment -%}
  Add a "Custom Liquid" block to the product section and paste:
    {% render 'engraving-preview', product: product, section: section %}

  Works with Dawn, Horizon and other Online Store 2.0 themes.

  Optional product metafields (namespace "engraving"):
    engraving.area       Single line text  Where the text sits on the photo, as
                                           "left,top,width,height" in % of the
                                           image. Default "22,56,56,16".
    engraving.max_chars  Integer           Characters per line. Default 26.
    engraving.fonts      Single line text  Comma-separated Google Fonts.
                                           Default "Playfair Display,Montserrat,Great Vibes".
    engraving.required   True or false     Make line 1 required. Default false.
{%- endcomment -%}

{%- liquid
  assign area = product.metafields.engraving.area.value | default: '22,56,56,16'
  assign max_chars = product.metafields.engraving.max_chars.value | default: 26
  assign font_list = product.metafields.engraving.fonts.value | default: 'Playfair Display,Montserrat,Great Vibes'
  assign fonts = font_list | split: ','
  assign required = product.metafields.engraving.required.value | default: false
  assign image = product.selected_or_first_available_variant.featured_media.preview_image | default: product.featured_image
  assign dawn_form_id = 'product-form-' | append: section.id
  assign form_id = form_id | default: dawn_form_id
  assign uid = section.id | append: '-' | append: product.id

  assign font_query = ''
  for font in fonts
    assign family = font | strip | replace: ' ', '+'
    assign font_query = font_query | append: '&family=' | append: family
  endfor
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ font_query | remove_first: '&' }}&display=swap">
{{ 'engraving-preview.css' | asset_url | stylesheet_tag }}

<div class="engraving" data-engraving-preview data-area="{{ area | escape }}">
  {%- if image -%}
    <div class="engraving__stage">
      {{
        image
        | image_url: width: 1100
        | image_tag:
          class: 'engraving__image',
          widths: '360, 550, 720, 900, 1100',
          sizes: '(min-width: 990px) 45vw, 100vw',
          loading: 'lazy',
          alt: image.alt
      }}
      <div class="engraving__area" aria-hidden="true">
        <span class="engraving__line" data-engraving-line="1"></span>
        <span class="engraving__line" data-engraving-line="2"></span>
      </div>
    </div>
  {%- endif -%}

  <div class="engraving__fields">
    <p class="engraving__title">Personalise your engraving</p>

    <div class="engraving__field">
      <label for="EngravingLine1-{{ uid }}">Line 1</label>
      <input
        id="EngravingLine1-{{ uid }}"
        type="text"
        name="properties[Line 1]"
        form="{{ form_id }}"
        maxlength="{{ max_chars }}"
        placeholder="e.g. Player of the Year"
        autocomplete="off"
        {% if required %}required{% endif %}
        data-engraving-input="1"
      >
      <span class="engraving__count" data-engraving-count="1">0/{{ max_chars }}</span>
    </div>

    <div class="engraving__field">
      <label for="EngravingLine2-{{ uid }}">Line 2 <span class="engraving__optional">(optional)</span></label>
      <input
        id="EngravingLine2-{{ uid }}"
        type="text"
        name="properties[Line 2]"
        form="{{ form_id }}"
        maxlength="{{ max_chars }}"
        placeholder="e.g. Brisbane Rovers 2026"
        autocomplete="off"
        data-engraving-input="2"
      >
      <span class="engraving__count" data-engraving-count="2">0/{{ max_chars }}</span>
    </div>

    <fieldset class="engraving__fonts">
      <legend>Font</legend>
      {%- for font in fonts -%}
        {%- assign name = font | strip -%}
        <label class="engraving__font" style="font-family: '{{ name }}', serif;">
          <input
            type="radio"
            name="properties[Font]"
            form="{{ form_id }}"
            value="{{ name | escape }}"
            {% if forloop.first %}checked{% endif %}
            data-engraving-font
          >
          <span>{{ name }}</span>
        </label>
      {%- endfor -%}
    </fieldset>

    <p class="engraving__note">The preview is a guide. We send an artwork proof before production.</p>
  </div>

  <p class="engraving__status" aria-live="polite" data-engraving-status></p>
</div>

<script src="{{ 'engraving-preview.js' | asset_url }}" defer></script>
